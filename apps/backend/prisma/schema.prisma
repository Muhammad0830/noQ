generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String            @id
  email            String            @unique
  name             String
  avatarUrl        String?
  role             Role              @default(USER)
  phoneNumber      String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @default(now()) @map("updated_at")
  bookings         Booking[]         @relation("UserBookings")
  favoriteServices FavoriteService[] @relation("UserFavoriteServices")
  favoriteShops    FavoriteShop[]    @relation("UserFavoriteShops")
  reviews          Review[]          @relation("UserReviews")
  shops            Shop[]            @relation("ShopOwner")
  staffs           Staff[]           @relation("UserStaffs")
}

model ShopCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  icon      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  shops     Shop[]
}

model Shop {
  id                 String         @id @default(uuid())
  name               String
  description        String?
  logoUrl            String?
  address            String
  phone              String
  categoryId         String
  ownerId            String
  isOpen             Boolean        @default(true)
  backgroundImageUrl String?
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @default(now()) @map("updated_at")
  timezone           String         @default("Asia/Tashkent")
  bookings           Booking[]
  favoriteShops      FavoriteShop[]
  reviews            Review[]
  services           Service[]
  category           ShopCategory   @relation(fields: [categoryId], references: [id])
  owner              User           @relation("ShopOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  blocks             ShopBlock[]
  shopSchedules      ShopSchedule[]
  staffs             Staff[]        @relation("ShopStaffs")

  @@index([categoryId])
  @@index([ownerId])
}

model Service {
  id          String            @id @default(uuid())
  name        String
  description String?
  price       Decimal           @db.Decimal(10, 2)
  durationMin Int
  isActive    Boolean           @default(true)
  shopId      String
  bufferTime  Int?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @default(now()) @map("updated_at")
  bookings    Booking[]
  favorites   FavoriteService[]
  reviews     Review[]
  shop        Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

model Booking {
  id                 String        @id @default(uuid())
  userId             String
  shopId             String
  serviceId          String?
  startTime          DateTime
  endTime            DateTime
  status             BookingStatus @default(PENDING)
  staffId            String?
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @default(now()) @map("updated_at")
  cancellationReason String?
  cancelledAt        DateTime?
  service            Service?      @relation(fields: [serviceId], references: [id])
  shop               Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  staff              Staff?        @relation("StaffBookings", fields: [staffId], references: [id])
  user               User          @relation("UserBookings", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([shopId, startTime])
  @@index([serviceId, startTime])
  @@index([status, createdAt, shopId])
  @@index([status, createdAt, serviceId])
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?
  userId    String
  shopId    String
  serviceId String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  service   Service? @relation(fields: [serviceId], references: [id])
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User     @relation("UserReviews", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([shopId])
  @@index([serviceId])
}

model FavoriteShop {
  id        String   @id @default(uuid())
  userId    String
  shopId    String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User     @relation("UserFavoriteShops", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])
  @@index([userId])
  @@index([shopId])
}

model FavoriteService {
  id        String   @id @default(uuid())
  userId    String
  serviceId String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user      User     @relation("UserFavoriteServices", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceId])
  @@index([userId])
  @@index([serviceId])
}

model ShopSchedule {
  id        String       @id @default(uuid())
  shopId    String
  dayOfWeek Int
  startTime String
  endTime   String
  type      ScheduleType @default(OPEN)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @default(now()) @map("updated_at")
  shop      Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

model ShopBlock {
  id        String   @id @default(uuid())
  shopId    String
  startTime DateTime
  endTime   DateTime
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

model Staff {
  id        String    @id @default(uuid())
  userId    String
  shopId    String
  role      StaffRole @default(STAFF)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @map("updated_at")
  bookings  Booking[] @relation("StaffBookings")
  shop      Shop      @relation("ShopStaffs", fields: [shopId], references: [id], onDelete: Cascade)
  user      User      @relation("UserStaffs", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])
  @@index([userId])
  @@index([shopId])
}

enum Role {
  USER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum StaffRole {
  OWNER
  MANAGER
  STAFF
}

enum ScheduleType {
  OPEN
  BLOCK
}
